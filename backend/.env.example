# Copy to .env. Everything here is optional.

# Fo: sign in with `python fo_login.py`. FO_TOKEN is only needed if Wajo hands you one.
FO_MCP_URL=https://mcp.api.wajo.ai/fo
FO_TOKEN=

TARGET_LANGUAGE=Arabic
NATIVE_LANGUAGE=English
DEFAULT_TIMEZONE=America/Vancouver

# Seconds of silence Fo waits before replying, so it doesn't cut you off mid-thought
PAUSE_SECONDS=3

# How long a fake session takes before you've signed in to Fo
MOCK_SECONDS=12
